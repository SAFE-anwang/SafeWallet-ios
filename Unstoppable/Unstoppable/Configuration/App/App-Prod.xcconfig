#include "../Config.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.anwang4.safewallet
APP_DISPLAY_NAME = SafeWallet
CODE_SIGN_ENTITLEMENTS = Unstoppable/Configuration/App/App-Prod.entitlements
PROVISIONING_PROFILE_SPECIFIER[config=Debug-Prod] = match Development com.anwang4.safewallet
PROVISIONING_PROFILE_SPECIFIER[config=Release-Prod] = match AppStore com.anwang4.safewallet
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

SHARED_CLOUD_CONTAINER_ID = iCloud.io.horizontalsystems.bank-wallet.shared
PRIVATE_CLOUD_CONTAINER_ID = iCloud.io.horizontalsystems.bank-wallet
