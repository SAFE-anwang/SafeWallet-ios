#include "../Config.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.anwang4.safewallet
APP_DISPLAY_NAME = SafeWallet
CODE_SIGN_ENTITLEMENTS = Unstoppable/Configuration/App/App-Dev.entitlements
PROVISIONING_PROFILE_SPECIFIER[config=Debug-Dev] = match Development com.anwang4.safewallet
PROVISIONING_PROFILE_SPECIFIER[config=Release-Dev] = match AdHoc com.anwang4.safewallet
ASSETCATALOG_COMPILER_APPICON_NAME = AppIconDev

SHARED_CLOUD_CONTAINER_ID = iCloud.io.horizontalsystems.bank-wallet.shared.dev
PRIVATE_CLOUD_CONTAINER_ID = iCloud.io.horizontalsystems.bank-wallet.dev
